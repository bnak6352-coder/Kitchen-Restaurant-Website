<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sabay Kitchen | Good food, good mood</title>
<style>
:root{--orange:#ea580c;--cream:#fffaf2;--ink:#292524;--muted:#78716c}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:#fffdf9}
header{position:sticky;top:0;background:#fffdf5ee;backdrop-filter:blur(12px);border-bottom:1px solid #f3e6d8;z-index:5}
.wrap{width:min(1100px,92%);margin:auto}.bar{display:flex;justify-content:space-between;align-items:center;padding:14px 0;gap:12px}.brand{font-weight:900;font-size:22px}.brand span,h1 span,h2 span{color:var(--orange)}nav{display:flex;gap:20px}a{color:inherit;text-decoration:none}nav a:hover{color:var(--orange)}
button{cursor:pointer;font:inherit;border:0}.btn{background:var(--orange);color:white;border-radius:999px;padding:11px 17px;font-weight:750}.outline{background:white;border:1px solid #f0a579;color:#c2410c;border-radius:999px;padding:10px 15px}
.hero{background:linear-gradient(90deg,#fff7e9 0%,#fff7e9e8 43%,#fff7e900 100%),url('https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1500&q=85') center/cover;min-height:420px;display:flex;align-items:center}.hero .copy{max-width:530px;padding:58px 0}.eyebrow{display:inline-block;background:#ffedd5;color:#9a3412;padding:8px 12px;border-radius:99px;font-size:13px;font-weight:700}h1{font-size:clamp(38px,6vw,64px);line-height:1.05;margin:18px 0}p{line-height:1.65;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;text-align:center;padding:23px 0;border-bottom:1px solid #f3e6d8}.features strong{display:block}.features small{color:var(--muted)}
section{scroll-margin-top:75px}.section{padding:48px 0}.section h2{font-size:32px;margin:0}.sub{margin-top:6px}.filters{display:flex;gap:8px;overflow:auto;margin:22px 0}.tag{white-space:nowrap;border:1px solid #eadfd3;background:white;padding:8px 13px;border-radius:99px}.tag.active{background:var(--orange);color:white;border-color:var(--orange)}
.menu{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.dish{border:1px solid #eee4d9;border-radius:15px;overflow:hidden;background:white}.dish img{width:100%;height:150px;object-fit:cover;display:block}.dish .body{padding:13px}.dish h3{font-size:16px;margin:5px 0}.dish p{font-size:13px;margin:7px 0 12px}.price{color:var(--orange);font-weight:850}.dish-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px}.add{background:var(--orange);color:white;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:750}
.about{background:#fff5e8}.aboutgrid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px}.aboutgrid img{width:100%;height:280px;object-fit:cover;border-radius:18px}.contact{background:#292524;color:white;border-radius:18px;padding:28px;display:flex;justify-content:space-between;align-items:center;gap:20px}.contact p{color:#ddd6ce}footer{text-align:center;padding:25px;border-top:1px solid #f3e6d8;color:var(--muted);font-size:13px}
.overlay{position:fixed;inset:0;background:#1c1917a8;display:none;align-items:center;justify-content:center;padding:15px;z-index:10}.overlay.show{display:flex}.modal{background:#fffdf9;padding:23px;border-radius:18px;width:min(440px,100%);max-height:90vh;overflow:auto}.modalhead{display:flex;justify-content:space-between;align-items:center}.modalhead h2{font-size:24px}.x{background:transparent;font-size:25px}.field{width:100%;border:1px solid #e7ddd1;border-radius:10px;padding:11px;margin:5px 0 13px;background:white}.label{font-size:13px;font-weight:750}.cartline{display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #eee4d9;padding:12px 0}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#292524;color:white;padding:12px 18px;border-radius:12px;display:none;z-index:20}
@media(max-width:800px){nav{display:none}.menu{grid-template-columns:repeat(2,1fr)}.dish img{height:125px}.aboutgrid{grid-template-columns:1fr}.hero{min-height:390px;background:linear-gradient(0deg,#fff7e9f5,#fff7e9b0),url('https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=80') center/cover}.hero .copy{padding:38px 0}.contact{align-items:flex-start;flex-direction:column}}
@media(max-width:380px){.menu{gap:9px}.dish .body{padding:9px}.dish-bottom{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<header><div class="wrap bar"><a href="#home"><div class="brand">🍲 Sabay<span> Kitchen</span></div><small style="color:#78716c">Good food · Good mood</small></a><nav><a href="#home">Home</a><a href="#menu">Menu</a><a href="#about">About</a><a href="#contact">Contact</a></nav><button class="outline" id="openCart">🛒 Cart <b id="count">0</b></button></div></header>
<main>
<section class="hero" id="home"><div class="wrap"><div class="copy"><span class="eyebrow">🌿 Fresh ingredients · Made with love</span><h1>Good food.<br><span>Happy hearts.</span></h1><p>Discover delicious dishes, fresh ingredients, and comforting flavors made for sharing with the people you love.</p><div class="actions"><a class="btn" href="#menu">Explore Menu ↗</a><button class="outline" id="openBooking">Book a Table</button></div></div></div></section>
<div class="wrap features"><div>🥬<strong>Fresh ingredients</strong><small>Made fresh to order</small></div><div>👨‍🍳<strong>Made with care</strong><small>Flavor in every bite</small></div><div>🛵<strong>Easy ordering</strong><small>Dine in or take away</small></div></div>
<section class="wrap section" id="menu"><span class="eyebrow">MADE FOR YOU</span><h2 style="margin-top:12px">Our Menu 🍽️</h2><p class="sub">Sample menu — edit dishes and prices to match your restaurant.</p><div class="filters" id="filters"><button class="tag active" data-cat="All">All dishes</button><button class="tag" data-cat="Rice">Rice</button><button class="tag" data-cat="Noodles">Noodles</button><button class="tag" data-cat="Soup">Soup & curry</button><button class="tag" data-cat="Drinks">Drinks</button></div><div class="menu" id="dishes"></div></section>
<section class="about section" id="about"><div class="wrap aboutgrid"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1000&q=80" alt="Cozy restaurant dining area" loading="lazy"><div><span class="eyebrow">A LITTLE ABOUT US</span><h2 style="margin-top:12px">A table for everyone.</h2><p>At Sabay Kitchen, good food brings people together. Our goal is to make every meal feel welcoming, delicious, and worth sharing.</p><p>❤️ Made with love<br>😊 Friendly service<br>🌿 Fresh ingredients</p></div></div></section>
<section class="wrap section" id="contact"><div class="contact"><div><span style="color:#fdba74;font-weight:750">COME SAY HELLO</span><h2 style="margin:7px 0">Your next favorite meal awaits.</h2><p>Questions or special requests? Prepare a message for our team.</p></div><button class="btn" id="contactBtn">Contact Us ✉</button></div></section>
</main><footer><b style="font-size:17px;color:#292524">🍲 Sabay Kitchen</b><br>Good food · Good mood<br><br>© <span id="year"></span> Sabay Kitchen · Demo website — update contact details before publishing.
<div class="toast" id="toast"></div>
<div class="overlay" id="cartModal"><div class="modal"><div class="modalhead"><h2>Your Cart 🛒</h2><button class="x" data-close="cartModal">×</button></div><div id="cartLines"></div><h3 style="display:flex;justify-content:space-between">Total <span id="total" class="price">0៛</span></h3><button class="btn" style="width:100%" id="checkout">Continue to Order</button><p style="font-size:12px">No payment is collected by this demo.</p></div></div>
<div class="overlay" id="orderModal"><form class="modal" id="orderForm"><div class="modalhead"><h2>Place an Order</h2><button type="button" class="x" data-close="orderModal">×</button></div><div id="orderSummary" style="white-space:pre-line;background:#fff1df;padding:12px;border-radius:10px;margin:12px 0"></div><label class="label">Your name *</label><input class="field" id="customer" required placeholder="Your name"><label class="label">Phone number *</label><input class="field" id="phone" type="tel" required placeholder="Phone number"><label class="label">Order method</label><select class="field" id="method"><option>Takeaway</option><option>Dine in</option><option>Delivery (confirm with restaurant)</option></select><label class="label">Notes</label><textarea class="field" id="notes" rows="2" placeholder="Address or special requests"></textarea><button class="btn" style="width:100%">Prepare Order Message</button><p style="font-size:12px">This prepares a message; it doesn't send your order automatically.</p></form></div>
<div class="overlay" id="bookingModal"><form class="modal" id="bookingForm"><div class="modalhead"><h2>Book a Table</h2><button type="button" class="x" data-close="bookingModal">×</button></div><label class="label">Your name *</label><input class="field" id="bookName" required><label class="label">Phone number *</label><input class="field" id="bookPhone" required type="tel"><label class="label">Date *</label><input class="field" id="bookDate" required type="date"><label class="label">Time *</label><input class="field" id="bookTime" required type="time"><label class="label">Guests</label><select class="field" id="guests"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7+</option></select><button class="btn" style="width:100%">Prepare Booking Message</button><p style="font-size:12px">Your booking isn't confirmed until the restaurant replies.</p></form></div>
<div class="overlay" id="resultModal"><div class="modal"><div class="modalhead"><h2 id="resultTitle">Message ready</h2><button class="x" data-close="resultModal">×</button></div><textarea class="field" id="resultText" rows="8" readonly></textarea><button class="btn" style="width:100%" id="copyBtn">Copy Message</button><p id="copyStatus" aria-live="polite"></p></div></div>
<script>
const dishes=[
{id:1,name:'Beef Fried Rice',cat:'Rice',price:10000,desc:'Savory rice with beef, egg and vegetables.',img:'photo-1512058564366-18510be2db19'},
{id:2,name:'Seafood Fried Rice',cat:'Rice',price:12000,desc:'Fried rice with shrimp, egg and vegetables.',img:'photo-1604908176997-125f25cc6f3d'},
{id:3,name:'Seafood Fried Noodles',cat:'Noodles',price:12000,desc:'Stir-fried noodles with seafood and greens.',img:'photo-1569718212165-3a8278d5f624'},
{id:4,name:'Chicken Noodle Soup',cat:'Noodles',price:10000,desc:'Comforting noodles in a flavorful broth.',img:'photo-1569718212165-3a8278d5f624'},
{id:5,name:'Chicken Curry',cat:'Soup',price:14000,desc:'Rich, fragrant curry with tender chicken.',img:'photo-1603894584373-5ac82b2ae398'},
{id:6,name:'Tom Yum Soup',cat:'Soup',price:12000,desc:'Tangy soup with herbs and seafood.',img:'photo-1547592180-85f173990554'},
{id:7,name:'Iced Coffee',cat:'Drinks',price:5000,desc:'A refreshing iced coffee.',img:'photo-1461023058943-07fcbe16d735'},
{id:8,name:'Fresh Fruit Juice',cat:'Drinks',price:6000,desc:'A cool, fruity refreshment.',img:'photo-1600271886742-f049cd451bba'}];
const cart={};let category='All';const money=n=>new Intl.NumberFormat('en-US').format(n)+'៛';const $=id=>document.getElementById(id);
function photo(id){return 'https://images.unsplash.com/'+id+'?auto=format&fit=crop&w=600&q=75'}
function renderDishes(){$('dishes').innerHTML=dishes.filter(d=>category==='All'||d.cat===category).map(d=>`<article class="dish"><img src="${photo(d.img)}" alt="${d.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=70'"><div class="body"><small style="color:#c2410c;font-weight:750">${d.cat}</small><h3>${d.name}</h3><p>${d.desc}</p><div class="dish-bottom"><span class="price">${money(d.price)}</span><button class="add" data-add="${d.id}">＋ Add</button></div></div></article>`).join('')}
function total(){return dishes.reduce((n,d)=>n+d.price*(cart[d.id]||0),0)}function count(){return Object.values(cart).reduce((a,b)=>a+b,0)}
function renderCart(){$('count').textContent=count();$('total').textContent=money(total());let items=dishes.filter(d=>cart[d.id]);$('cartLines').innerHTML=items.length?items.map(d=>`<div class="cartline"><div><b>${d.name}</b><br><small>${money(d.price)} each</small></div><div><button class="outline" data-qty="${d.id}" data-delta="-1">−</button> ${cart[d.id]} <button class="outline" data-qty="${d.id}" data-delta="1">+</button></div></div>`).join(''):'<p>Your cart is empty. Add a dish to get started! 🍜';$('checkout').disabled=!items.length;$('checkout').style.opacity=items.length?1:.5}
function open(id){$(id).classList.add('show')}function close(id){$(id).classList.remove('show')}function toast(msg){$('toast').textContent=msg;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',2200)}
$('filters').onclick=e=>{let b=e.target.closest('[data-cat]');if(!b)return;category=b.dataset.cat;document.querySelectorAll('[data-cat]').forEach(x=>x.classList.toggle('active',x===b));renderDishes()};
$('dishes').onclick=e=>{let b=e.target.closest('[data-add]');if(!b)return;let id=+b.dataset.add;cart[id]=(cart[id]||0)+1;renderCart();toast('Added to cart!')};
$('cartLines').onclick=e=>{let b=e.target.closest('[data-qty]');if(!b)return;let id=+b.dataset.qty;cart[id]=(cart[id]||0)+ +b.dataset.delta;if(cart[id]<=0)delete cart[id];renderCart()};
$('openCart').onclick=()=>open('cartModal');$('checkout').onclick=()=>{if(!count())return;close('cartModal');$('orderSummary').textContent=dishes.filter(d=>cart[d.id]).map(d=>`${cart[d.id]} × ${d.name} — ${money(cart[d.id]*d.price)}`).join('\n')+'\nTotal: '+money(total());open('orderModal')};
$('orderForm').onsubmit=e=>{e.preventDefault();$('resultTitle').textContent='Order message ready';$('resultText').value='SABAY KITCHEN — ORDER REQUEST\nName: '+$('customer').value+'\nPhone: '+$('phone').value+'\nMethod: '+$('method').value+'\n\n'+dishes.filter(d=>cart[d.id]).map(d=>`${cart[d.id]} × ${d.name} — ${money(cart[d.id]*d.price)}`).join('\n')+'\nTotal: '+money(total())+'\nNotes: '+($('notes').value||'None')+'\n\nPlease confirm my order.';close('orderModal');open('resultModal')};
$('openBooking').onclick=()=>{let d=new Date();$('bookDate').min=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');open('bookingModal')};
$('bookingForm').onsubmit=e=>{e.preventDefault();$('resultTitle').textContent='Booking message ready';$('resultText').value='SABAY KITCHEN — TABLE BOOKING REQUEST\nName: '+$('bookName').value+'\nPhone: '+$('bookPhone').value+'\nDate: '+$('bookDate').value+'\nTime: '+$('bookTime').value+'\nGuests: '+$('guests').value+'\nPlease confirm my booking.';close('bookingModal');open('resultModal')};
$('contactBtn').onclick=()=>{$('resultTitle').textContent='Contact Sabay Kitchen';$('resultText').value='Welcome to Sabay Kitchen!\n\nAdd your real phone number, Telegram, address and opening hours before publishing.';open('resultModal')};
$('copyBtn').onclick=async()=>{try{await navigator.clipboard.writeText($('resultText').value);$('copyStatus').textContent='Copied! Paste your message wherever you need.'}catch(e){$('resultText').select();$('copyStatus').textContent='Select the text and copy it.'}};
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>close(b.dataset.close));document.querySelectorAll('.overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)close(o.id)}));$('year').textContent=new Date().getFullYear();renderDishes();renderCart();
</script>
</body></html>